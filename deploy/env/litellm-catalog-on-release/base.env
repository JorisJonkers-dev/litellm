# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
# The sync lists and probes at the providers with these keys and opens a pull request with the
# deployments it planned. It never calls the proxy, so it needs no master key and no proxy address.
VIBE_API_KEY=${secret:secret/data/platform/litellm#vibe_api_key}
VIBE_STUDY_API_KEY=${secret:secret/data/platform/litellm#vibe_study_api_key}
# The two general Mistral API keys: more models than a Vibe plan, billed per token.
VIBE_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_api_general_key}
VIBE_STUDY_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_study_api_general_key}
OPENCODE_GO_API_KEY=${secret:secret/data/platform/litellm#opencode_go_api_key}
OPENROUTER_API_KEY=${secret:secret/data/platform/litellm#openrouter_api_key}
# Free-only routes (agent-kit#916). axforge_api_key stays empty until the account exists: the sync
# skips a route whose key is empty. Kilo and OVHcloud have no key at all: the sync lists and probes
# them with no Authorization header (the placeholder below is only the proxy credential's).
GROQ_API_KEY=${secret:secret/data/platform/litellm#groq_api_key}
CLOUDFLARE_API_KEY=${secret:secret/data/platform/litellm#cloudflare_api_key}
NVIDIA_NIM_API_KEY=${secret:secret/data/platform/litellm#nvidia_nim_api_key}
ZAI_API_KEY=${secret:secret/data/platform/litellm#zai_api_key}
REQUESTY_API_KEY=${secret:secret/data/platform/litellm#requesty_api_key}
AXFORGE_API_KEY=${secret:secret/data/platform/litellm#axforge_api_key}
NAGA_API_KEY=${secret:secret/data/platform/litellm#naga_api_key}
ROUTEWAY_API_KEY=${secret:secret/data/platform/litellm#routeway_api_key}
INFERBASE_API_KEY=${secret:secret/data/platform/litellm#inferbase_api_key}
# Second-wave free-only routes (agent-kit#916, litellm#64). Every key is optional: a route whose key is empty is skipped.
# UnoRouter answers 401 without a key, so it is keyed like the rest. The bases the spec does not name (BazaarLink, Cohere, watsonx) and the
# account and project ids are optional Vault fields, set at the end of this file.
BAZAARLINK_API_KEY=${secret:secret/data/platform/litellm#bazaarlink_api_key}
ELECTRONHUB_API_KEY=${secret:secret/data/platform/litellm#electronhub_api_key}
UNOROUTER_API_KEY=${secret:secret/data/platform/litellm#unorouter_api_key}
COHERE_API_KEY=${secret:secret/data/platform/litellm#cohere_api_key}
AIRFORCE_API_KEY=${secret:secret/data/platform/litellm#airforce_api_key}
PLUGSKY_API_KEY=${secret:secret/data/platform/litellm#plugsky_api_key}
POE_API_KEY=${secret:secret/data/platform/litellm#poe_api_key}
VERCEL_AI_GATEWAY_API_KEY=${secret:secret/data/platform/litellm#vercel_ai_gateway_api_key}
WATSONX_API_KEY=${secret:secret/data/platform/litellm#watsonx_api_key}
NOVITA_API_KEY=${secret:secret/data/platform/litellm#novita_api_key}
TOGETHER_API_KEY=${secret:secret/data/platform/litellm#together_api_key}
TYPHOON_API_KEY=${secret:secret/data/platform/litellm#typhoon_api_key}
SEALION_API_KEY=${secret:secret/data/platform/litellm#sealion_api_key}
GONKA_API_KEY=${secret:secret/data/platform/litellm#gonka_api_key}
LONGCAT_API_KEY=${secret:secret/data/platform/litellm#longcat_api_key}
NEOSANTARA_API_KEY=${secret:secret/data/platform/litellm#neosantara_api_key}
ANONYMOUS_UPSTREAM_KEY=anonymous
# The Google free-tier AI Studio key and the Anthropic key.
GEMINI_API_KEY=${secret:secret/data/platform/litellm#google_api_key}
ANTHROPIC_API_KEY=${secret:secret/data/platform/litellm#anthropic_api_key}
# A fine-grained token with contents:write on the catalogue repository.
CATALOG_TOKEN=${secret:secret/data/platform/litellm#catalog_publish_token}

MISTRAL_API_BASE=https://api.mistral.ai/v1
# OpenCode Go's own list base: its /models names every Go model with the family and base it is served
# on, where .../go/openai/v1/models lists only some of them.
OPENCODE_GO_API_BASE=https://opencode.ai/inference/go/v1
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
GROQ_API_BASE=https://api.groq.com/openai/v1
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
ZAI_API_BASE=https://api.z.ai/api/paas/v4
KILO_API_BASE=https://ai-gateway.kilo.ai/api/v1
OVHCLOUD_API_BASE=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
REQUESTY_API_BASE=https://router.requesty.ai/v1
AXFORGE_API_BASE=https://api.axforge.ai/v1
NAGA_API_BASE=https://api.naga.ac/v1
ROUTEWAY_API_BASE=https://api.routeway.ai/v1
INFERBASE_API_BASE=https://api.inferbase.ai/v1
ELECTRONHUB_API_BASE=https://api.electronhub.ai/v1
UNOROUTER_API_BASE=https://api.unorouter.ai/v1
AIRFORCE_API_BASE=https://api.airforce/v1
PLUGSKY_API_BASE=https://api.plugsky.com/v1
POE_API_BASE=https://api.poe.com/v1
VERCEL_AI_GATEWAY_API_BASE=https://ai-gateway.vercel.sh/v1
NOVITA_API_BASE=https://api.novita.ai/openai/v1
TOGETHER_API_BASE=https://api.together.ai/v1
TYPHOON_API_BASE=https://api.opentyphoon.ai/v1
SEALION_API_BASE=https://api.sea-lion.ai/v1
GONKA_API_BASE=https://proxy.gonkabroker.com/v1
LONGCAT_API_BASE=https://api.longcat.chat/openai/v1
NEOSANTARA_API_BASE=https://api.neosantara.xyz/v1
# Google answers OpenAI-style chat on this base; Anthropic has its own API (messages and models).
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# The GPU workstation's keyed gate (see deploy/env/litellm/base.env).
LOCAL_LLM_API_BASE=http://100.112.121.102:11435/v1
LOCAL_LLM_API_KEY=${secret:secret/data/platform/litellm#local_llm_api_key}

# Where the catalogue is published; the same file is the sync's cache.
CATALOG_REPO=JorisJonkers-dev/litellm-model-catalog
CATALOG_PATH=model-catalog.json

# Where the generated routing goes: a pull request against this repository, from a bot branch.
# MODELS_TOKEN is a fine-grained token with contents:write and pull-requests:write on it.
MODELS_REPO=JorisJonkers-dev/litellm
MODELS_PATH=config/models.generated.yaml
MODELS_BRANCH=bot/model-catalog
MODELS_TOKEN=${secret:secret/data/platform/litellm#catalog_pr_token}
# Provider settings that are not secrets are Vault fields too (secret/platform/litellm), optional: an unset
# field arrives empty and the route is skipped with one route error naming the field. Cloudflare's base is composed
# from the account id; Cohere's COHERE_LIST_BASE is the OpenAI-compatible base the sync lists and probes (not
# COHERE_API_BASE, which LiteLLM's cohere_chat would read); watsonx's URL is read by LiteLLM as WATSONX_API_BASE (WATSONX_URL is its alias).
CLOUDFLARE_ACCOUNT_ID=${secret:secret/data/platform/litellm#cloudflare_account_id}
BAZAARLINK_API_BASE=${secret:secret/data/platform/litellm#bazaarlink_api_base}
COHERE_LIST_BASE=${secret:secret/data/platform/litellm#cohere_api_base}
WATSONX_API_BASE=${secret:secret/data/platform/litellm#watsonx_api_base}
WATSONX_PROJECT_ID=${secret:secret/data/platform/litellm#watsonx_project_id}
WATSONX_URL=${secret:secret/data/platform/litellm#watsonx_api_base}
# Real traffic through the proxy (catalog/sync.py traffic_evidence): the estate Prometheus, in-cluster.
TRAFFIC_PROMETHEUS_URL=http://prometheus.observability-system.svc.cluster.local:9090
