# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
LITELLM_MASTER_KEY=${secret:secret/data/platform/litellm#master_key}
VIBE_API_KEY=${secret:secret/data/platform/litellm#vibe_api_key}
VIBE_STUDY_API_KEY=${secret:secret/data/platform/litellm#vibe_study_api_key}
OPENCODE_GO_API_KEY=${secret:secret/data/platform/litellm#opencode_go_api_key}
OPENROUTER_API_KEY=${secret:secret/data/platform/litellm#openrouter_api_key}
# The paid Mistral API keys and the Google and Anthropic keys: the sync lists and probes their
# models with them, and the proxy registers the deployments that name them.
VIBE_API_KEY_PAID=${secret:secret/data/platform/litellm#vibe_api_key_paid}
VIBE_STUDY_API_KEY_PAID=${secret:secret/data/platform/litellm#vibe_study_api_key_paid}
GOOGLE_API_KEY=${secret:secret/data/platform/litellm#google_api_key}
ANTHROPIC_API_KEY=${secret:secret/data/platform/litellm#anthropic_api_key}
CATALOG_TOKEN=${secret:secret/data/platform/litellm#catalog_publish_token}

# The proxy, by its Service: one placeholder per value; catalog/sync.py composes the URL.
LITELLM_HOST=${dependency:litellm.host}
LITELLM_PORT=${dependency:litellm.port}

MISTRAL_API_BASE=https://api.mistral.ai/v1
OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Google answers OpenAI-style chat on this base; Anthropic has its own API (messages and models).
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
LOCAL_LLM_API_BASE=http://llm-local.llm-local-system:11434/v1
LOCAL_LLM_API_KEY=none

# Where the catalogue is published; the same file is the sync's cache.
CATALOG_REPO=JorisJonkers-dev/litellm-model-catalog
CATALOG_PATH=model-catalog.json
