# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
# The sync lists and probes at the providers with these keys and opens a pull request with the
# deployments it planned. It never calls the proxy, so it needs no master key and no proxy address.
VIBE_API_KEY=${secret:secret/data/platform/litellm#vibe_api_key}
VIBE_STUDY_API_KEY=${secret:secret/data/platform/litellm#vibe_study_api_key}
# The two general Mistral API keys: more models than a Vibe plan, billed per token.
VIBE_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_api_general_key}
VIBE_STUDY_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_study_api_general_key}
OPENCODE_GO_API_KEY=${secret:secret/data/platform/litellm#opencode_go_api_key}
OPENROUTER_API_KEY=${secret:secret/data/platform/litellm#openrouter_api_key}
# An OpenCode Zen (pay as you go) API key with no credit on its account: the opencode-free route
# deploys Zen's free models only.
OPENCODE_FREE_API_KEY=${secret:secret/data/platform/litellm#opencode_free_api_key}
# The Google free-tier AI Studio key and the Anthropic key.
GEMINI_API_KEY=${secret:secret/data/platform/litellm#google_api_key}
ANTHROPIC_API_KEY=${secret:secret/data/platform/litellm#anthropic_api_key}
# A fine-grained token with contents:write on the catalogue repository.
CATALOG_TOKEN=${secret:secret/data/platform/litellm#catalog_publish_token}

MISTRAL_API_BASE=https://api.mistral.ai/v1
OPENCODE_GO_API_BASE=https://opencode.ai/inference/go/openai/v1
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OpenCode Zen's OpenAI-compatible base (its free models are served on chat-completions).
OPENCODE_FREE_API_BASE=https://opencode.ai/inference/openai/v1
# Google answers OpenAI-style chat on this base; Anthropic has its own API (messages and models).
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
LOCAL_LLM_API_BASE=http://llm-local.llm-local-system:11434/v1
LOCAL_LLM_API_KEY=none

# Where the catalogue is published; the same file is the sync's cache.
CATALOG_REPO=JorisJonkers-dev/litellm-model-catalog
CATALOG_PATH=model-catalog.json

# Where the generated routing goes: a pull request against this repository, from a bot branch.
# MODELS_TOKEN is a fine-grained token with contents:write and pull-requests:write on it.
MODELS_REPO=JorisJonkers-dev/litellm
MODELS_PATH=config/models.generated.yaml
MODELS_BRANCH=bot/model-catalog
MODELS_TOKEN=${secret:secret/data/platform/litellm#catalog_pr_token}
