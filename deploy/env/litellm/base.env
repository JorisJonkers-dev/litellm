# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
LITELLM_MASTER_KEY=${secret:secret/data/platform/litellm#master_key}
LITELLM_SALT_KEY=${secret:secret/data/platform/litellm#salt_key}
# The upstream keys config.yaml names as os.environ/<NAME>, one per credential_list entry.
VIBE_API_KEY=${secret:secret/data/platform/litellm#vibe_api_key}
VIBE_STUDY_API_KEY=${secret:secret/data/platform/litellm#vibe_study_api_key}
# The two general Mistral API keys: more models than a Vibe plan, billed per token.
VIBE_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_api_general_key}
VIBE_STUDY_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_study_api_general_key}
OPENCODE_GO_API_KEY=${secret:secret/data/platform/litellm#opencode_go_api_key}
OPENROUTER_API_KEY=${secret:secret/data/platform/litellm#openrouter_api_key}
# Free-only routes (agent-kit#916). Keys are Vault fields; axforge_api_key stays empty until the
# account exists, and the sync skips a route whose key is empty.
GROQ_API_KEY=${secret:secret/data/platform/litellm#groq_api_key}
CLOUDFLARE_API_KEY=${secret:secret/data/platform/litellm#cloudflare_api_key}
NVIDIA_NIM_API_KEY=${secret:secret/data/platform/litellm#nvidia_nim_api_key}
ZAI_API_KEY=${secret:secret/data/platform/litellm#zai_api_key}
REQUESTY_API_KEY=${secret:secret/data/platform/litellm#requesty_api_key}
AXFORGE_API_KEY=${secret:secret/data/platform/litellm#axforge_api_key}
NAGA_API_KEY=${secret:secret/data/platform/litellm#naga_api_key}
ROUTEWAY_API_KEY=${secret:secret/data/platform/litellm#routeway_api_key}
INFERBASE_API_KEY=${secret:secret/data/platform/litellm#inferbase_api_key}
# Second-wave free-only routes (agent-kit#916, litellm#64). Every key is optional: a route whose key is empty is skipped.
# UnoRouter is anonymous (ANONYMOUS_UPSTREAM_KEY). The spec names no base for BazaarLink, Cohere or watsonx: BazaarLink's
# is a placeholder the owner replaces with the key (the route is inert until then), and Cohere and watsonx have none.
BAZAARLINK_API_KEY=${secret:secret/data/platform/litellm#bazaarlink_api_key}
ELECTRONHUB_API_KEY=${secret:secret/data/platform/litellm#electronhub_api_key}
COHERE_API_KEY=${secret:secret/data/platform/litellm#cohere_api_key}
AIRFORCE_API_KEY=${secret:secret/data/platform/litellm#airforce_api_key}
PLUGSKY_API_KEY=${secret:secret/data/platform/litellm#plugsky_api_key}
POE_API_KEY=${secret:secret/data/platform/litellm#poe_api_key}
VERCEL_AI_GATEWAY_API_KEY=${secret:secret/data/platform/litellm#vercel_ai_gateway_api_key}
WATSONX_API_KEY=${secret:secret/data/platform/litellm#watsonx_api_key}
NOVITA_API_KEY=${secret:secret/data/platform/litellm#novita_api_key}
TOGETHER_API_KEY=${secret:secret/data/platform/litellm#together_api_key}
TYPHOON_API_KEY=${secret:secret/data/platform/litellm#typhoon_api_key}
SEALION_API_KEY=${secret:secret/data/platform/litellm#sealion_api_key}
GONKA_API_KEY=${secret:secret/data/platform/litellm#gonka_api_key}
LONGCAT_API_KEY=${secret:secret/data/platform/litellm#longcat_api_key}
NEOSANTARA_API_KEY=${secret:secret/data/platform/litellm#neosantara_api_key}
# Kilo and OVHcloud are anonymous: LiteLLM's openai/ provider wants some key, this one is never a
# real credential. The sync sends no Authorization header to them (its KILO_API_KEY is never set).
ANONYMOUS_UPSTREAM_KEY=anonymous
# The Google free-tier AI Studio key and the Anthropic key. Their credentials carry the key only:
# LiteLLM addresses both providers itself.
GEMINI_API_KEY=${secret:secret/data/platform/litellm#google_api_key}
ANTHROPIC_API_KEY=${secret:secret/data/platform/litellm#anthropic_api_key}

# The upstream bases config.yaml names as os.environ/<NAME>. They are not secrets, and the
# image test points them at a stub upstream.
MISTRAL_API_BASE=https://api.mistral.ai/v1
# No OPENCODE_GO_API_BASE: LiteLLM's opencode_go provider would send every model to that one base,
# and Go serves Responses, Messages and Gemini models on bases of their own.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
GROQ_API_BASE=https://api.groq.com/openai/v1
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
ZAI_API_BASE=https://api.z.ai/api/paas/v4
KILO_API_BASE=https://ai-gateway.kilo.ai/api/v1
OVHCLOUD_API_BASE=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
REQUESTY_API_BASE=https://router.requesty.ai/v1
AXFORGE_API_BASE=https://api.axforge.ai/v1
NAGA_API_BASE=https://api.naga.ac/v1
ROUTEWAY_API_BASE=https://api.routeway.ai/v1
INFERBASE_API_BASE=https://api.inferbase.ai/v1
ELECTRONHUB_API_BASE=https://api.electronhub.ai/v1
UNOROUTER_API_BASE=https://api.unorouter.ai/v1
AIRFORCE_API_BASE=https://api.airforce/v1
PLUGSKY_API_BASE=https://api.plugsky.com/v1
POE_API_BASE=https://api.poe.com/v1
VERCEL_AI_GATEWAY_API_BASE=https://ai-gateway.vercel.sh/v1
NOVITA_API_BASE=https://api.novita.ai/v3/openai
TOGETHER_API_BASE=https://api.together.ai/v1
TYPHOON_API_BASE=https://api.opentyphoon.ai/v1
SEALION_API_BASE=https://api.sea-lion.ai/v1
GONKA_API_BASE=https://proxy.gonkabroker.com/v1
LONGCAT_API_BASE=https://api.longcat.chat/openai/v1
NEOSANTARA_API_BASE=https://api.neosantara.xyz/v1
BAZAARLINK_API_BASE=REPLACE_WITH_BAZAARLINK_API_BASE
# Cloudflare Workers AI: the base is composed from this account id (sidebar of dash.cloudflare.com).
# PLACEHOLDER: the owner replaces it with the real account id; until then the route cannot be listed.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
# The sync's own env file carries these too. The proxy needs them only where a credential names
# them, and the google and anthropic credentials name no base.
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# The OpenAI-compatible model server on the GPU workstation (enschede-rx7900xtx-1, RX 7900 XTX,
# ROCm Ollama). Ollama listens on loopback there; a keyed gate serves its /v1 on the node's
# tailnet address, port 11435, to a caller with the gate key (nix-config
# services.llmLocalGate, agent-kit#569). The key is local_llm_api_key: only this namespace
# holds it, so a pod anywhere else gets 401. While a game holds the GPU the gate answers 503 at once.
LOCAL_LLM_API_BASE=http://100.112.121.102:11435/v1
LOCAL_LLM_API_KEY=${secret:secret/data/platform/litellm#local_llm_api_key}

# deploy-kit values are one placeholder each, so the URL is not composed here: LiteLLM
# builds it from its parts (to confirm against the pinned image on the first render).
DATABASE_HOST=${dependency:platform-postgres.host}
DATABASE_USERNAME=${dependency:platform-postgres.username}
DATABASE_PASSWORD=${dependency:platform-postgres.password}
DATABASE_NAME=litellm_db

LITELLM_TELEMETRY=False
LITELLM_MODE=PRODUCTION
# The admin UI is on. It signs in through auth-api (the estate's OIDC provider) with LiteLLM's
# generic SSO, which is free for up to 5 users; there is no username and password login (see
# disable_env_credential_login in config.yaml). Do not set DISABLE_ADMIN_UI, UI_USERNAME or
# UI_PASSWORD here: without UI_PASSWORD the master key would be accepted as the UI password.
PROXY_BASE_URL=https://litellm.jorisjonkers.dev
# Opening /ui goes straight to the auth-api sign-in instead of LiteLLM's login page (which has no
# password form here). It takes effect only because the generic SSO settings below are complete.
AUTO_REDIRECT_UI_LOGIN_TO_SSO=true
# The host is public, so the API docs pages and the OpenAPI schema (every route, admin ones
# included) are not served.
NO_DOCS=true
NO_REDOC=true
NO_OPENAPI=true
GENERIC_CLIENT_ID=litellm
GENERIC_CLIENT_SECRET=${secret:secret/data/platform/litellm#oidc_client_secret}
GENERIC_AUTHORIZATION_ENDPOINT=https://auth.jorisjonkers.dev/api/oauth2/authorize
GENERIC_TOKEN_ENDPOINT=https://auth.jorisjonkers.dev/api/oauth2/token
GENERIC_USERINFO_ENDPOINT=https://auth.jorisjonkers.dev/api/userinfo
GENERIC_SCOPE=openid email profile
# auth-api requires PKCE for this client. LiteLLM generates a random state per sign-in unless
# GENERIC_CLIENT_STATE is set, so that is never set.
GENERIC_CLIENT_USE_PKCE=true
# The roles claim is in the ID token, not the userinfo response: merge the token claims in.
GENERIC_INCLUDE_TOKEN_CLAIMS=true
# The immutable subject, not the renameable username: a renamed or reused username must not
# inherit another person's LiteLLM user and keys.
GENERIC_USER_ID_ATTRIBUTE=sub
GENERIC_USER_DISPLAY_NAME_ATTRIBUTE=name
GENERIC_USER_EMAIL_ATTRIBUTE=email
# auth-api's ROLE_ADMIN is the only claim that makes a proxy admin. Everyone else, and anybody
# whose roles claim is missing, is a viewer, which ui_access_mode: admin_only then refuses.
GENERIC_ROLE_MAPPINGS_GROUP_CLAIM=roles
GENERIC_ROLE_MAPPINGS_ROLES={'proxy_admin':['ROLE_ADMIN']}
GENERIC_ROLE_MAPPINGS_DEFAULT_ROLE=internal_user_viewer
# Traces go to the collector's gRPC port (the python runtime profile sets the endpoint).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
