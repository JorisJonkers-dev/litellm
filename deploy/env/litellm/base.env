# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
LITELLM_MASTER_KEY=${secret:secret/data/platform/litellm#master_key}
LITELLM_SALT_KEY=${secret:secret/data/platform/litellm#salt_key}
# The upstream keys config.yaml names as os.environ/<NAME>, one per credential_list entry.
VIBE_API_KEY=${secret:secret/data/platform/litellm#vibe_api_key}
VIBE_STUDY_API_KEY=${secret:secret/data/platform/litellm#vibe_study_api_key}
# The two general Mistral API keys: more models than a Vibe plan, billed per token.
VIBE_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_api_general_key}
VIBE_STUDY_API_GENERAL_KEY=${secret:secret/data/platform/litellm#vibe_study_api_general_key}
OPENCODE_GO_API_KEY=${secret:secret/data/platform/litellm#opencode_go_api_key}
OPENROUTER_API_KEY=${secret:secret/data/platform/litellm#openrouter_api_key}
# The Google free-tier AI Studio key and the Anthropic key. Their credentials carry the key only:
# LiteLLM addresses both providers itself.
GEMINI_API_KEY=${secret:secret/data/platform/litellm#google_api_key}
ANTHROPIC_API_KEY=${secret:secret/data/platform/litellm#anthropic_api_key}

# The upstream bases config.yaml names as os.environ/<NAME>. They are not secrets, and the
# image test points them at a stub upstream.
MISTRAL_API_BASE=https://api.mistral.ai/v1
OPENCODE_GO_API_BASE=https://opencode.ai/inference/go/openai/v1
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# The sync's own env file carries these too. The proxy needs them only where a credential names
# them, and the google and anthropic credentials name no base.
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# The OpenAI-compatible model server on the GPU workstation (RX 7900 XTX, ROCm). Ollama
# serves /v1 on 11434 there today. This address is a placeholder until the agent-kit follow-up
# that makes it reachable from the cluster lands; local/* answers 502 until then. It needs no key.
LOCAL_LLM_API_BASE=http://llm-local.llm-local-system:11434/v1
LOCAL_LLM_API_KEY=none

# deploy-kit values are one placeholder each, so the URL is not composed here: LiteLLM
# builds it from its parts (to confirm against the pinned image on the first render).
DATABASE_HOST=${dependency:platform-postgres.host}
DATABASE_USERNAME=${dependency:platform-postgres.username}
DATABASE_PASSWORD=${dependency:platform-postgres.password}
DATABASE_NAME=litellm_db

LITELLM_TELEMETRY=False
LITELLM_MODE=PRODUCTION
# The admin UI is on. It signs in through auth-api (the estate's OIDC provider) with LiteLLM's
# generic SSO, which is free for up to 5 users; there is no username and password login (see
# disable_env_credential_login in config.yaml). Do not set DISABLE_ADMIN_UI, UI_USERNAME or
# UI_PASSWORD here: without UI_PASSWORD the master key would be accepted as the UI password.
PROXY_BASE_URL=https://litellm.jorisjonkers.dev
# Opening /ui goes straight to the auth-api sign-in instead of LiteLLM's login page (which has no
# password form here). It takes effect only because the generic SSO settings below are complete.
AUTO_REDIRECT_UI_LOGIN_TO_SSO=true
# The host is public, so the API docs pages and the OpenAPI schema (every route, admin ones
# included) are not served.
NO_DOCS=true
NO_REDOC=true
NO_OPENAPI=true
GENERIC_CLIENT_ID=litellm
GENERIC_CLIENT_SECRET=${secret:secret/data/platform/litellm#oidc_client_secret}
GENERIC_AUTHORIZATION_ENDPOINT=https://auth.jorisjonkers.dev/api/oauth2/authorize
GENERIC_TOKEN_ENDPOINT=https://auth.jorisjonkers.dev/api/oauth2/token
GENERIC_USERINFO_ENDPOINT=https://auth.jorisjonkers.dev/api/userinfo
GENERIC_SCOPE=openid email profile
# auth-api requires PKCE for this client. LiteLLM generates a random state per sign-in unless
# GENERIC_CLIENT_STATE is set, so that is never set.
GENERIC_CLIENT_USE_PKCE=true
# The roles claim is in the ID token, not the userinfo response: merge the token claims in.
GENERIC_INCLUDE_TOKEN_CLAIMS=true
# The immutable subject, not the renameable username: a renamed or reused username must not
# inherit another person's LiteLLM user and keys.
GENERIC_USER_ID_ATTRIBUTE=sub
GENERIC_USER_DISPLAY_NAME_ATTRIBUTE=name
GENERIC_USER_EMAIL_ATTRIBUTE=email
# auth-api's ROLE_ADMIN is the only claim that makes a proxy admin. Everyone else, and anybody
# whose roles claim is missing, is a viewer, which ui_access_mode: admin_only then refuses.
GENERIC_ROLE_MAPPINGS_GROUP_CLAIM=roles
GENERIC_ROLE_MAPPINGS_ROLES={'proxy_admin':['ROLE_ADMIN']}
GENERIC_ROLE_MAPPINGS_DEFAULT_ROLE=internal_user_viewer
# Traces go to the collector's gRPC port (the python runtime profile sets the endpoint).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
