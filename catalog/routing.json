{
  "tiers": [
    [["local", 1]],
    [["google", 1], ["anthropic", 1]],
    [["vibe", 2], ["vibe-study", 1]],
    [["vibe-api", 2], ["vibe-study-api", 1]],
    [["opencode-go", 1]]
  ],
  "backup_only": {
    "opencode-go": ["vibe", "vibe-study", "vibe-api", "vibe-study-api", "anthropic"]
  },
  "exclusive": [
    {"match": "^claude", "routes": ["anthropic"]}
  ],
  "free_first_unless_served_by": ["google", "anthropic", "vibe", "vibe-study", "vibe-api", "vibe-study-api"],
  "aliases": {
    "claude-sonnet-4.5": "claude-sonnet-4-5",
    "claude-opus-4.5": "claude-opus-4-5",
    "claude-haiku-4.5": "claude-haiku-4-5",
    "claude-3.5-sonnet": "claude-3-5-sonnet",
    "claude-3.5-haiku": "claude-3-5-haiku"
  },
  "api_only_routes": ["vibe-api", "vibe-study-api"],
  "budgets": {
    "vibe": {"max_budget": 255, "budget_duration": "30d"},
    "vibe-study": {"max_budget": 128, "budget_duration": "30d"},
    "vibe-api": {"max_budget": 50, "budget_duration": "30d"},
    "vibe-study-api": {"max_budget": 25, "budget_duration": "30d"},
    "google": {"max_budget": 50, "budget_duration": "30d"},
    "anthropic": {"max_budget": 50, "budget_duration": "30d"}
  },
  "limits": {
    "vibe": {"rpm": 60, "tpm": 1000000},
    "vibe-study": {"rpm": 30, "tpm": 500000}
  }
}
